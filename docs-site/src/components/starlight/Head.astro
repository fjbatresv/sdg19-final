---
/**
 * Starlight Head override: shared OG image, structured data for docs pages,
 * and no canonical + noindex on the 404 page.
 */
const route = Astro.locals.starlightRoute;
const { entry } = route;
const site = Astro.site ?? new URL('https://sdg19.fjbatresv.com');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const abs = (path: string) => new URL(`${base}${path.replace(/^\//, '')}`, site).href;

const isNotFound = entry.id === '404';
const head = isNotFound
  ? route.head.filter(({ tag, attrs }) => !(tag === 'link' && attrs?.rel === 'canonical'))
  : route.head;

const ogImage = abs('assets/og-sdg19.png');
const ogAlt = 'SDG19 — serverless commerce on AWS: architecture overview';
const pageUrl = new URL(Astro.url.pathname, site).href;
const isDocsHome = entry.id === 'docs';
const title = entry.data.title;

const jsonLd = isNotFound
  ? null
  : {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'TechArticle',
          headline: title,
          description: entry.data.description,
          url: pageUrl,
          inLanguage: 'es',
          image: ogImage,
          author: { '@type': 'Person', name: 'Javier Batres', url: 'https://fjbatresv.com' },
          isPartOf: { '@type': 'WebSite', name: 'SDG19', url: abs('/') },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'SDG19', item: abs('/') },
            { '@type': 'ListItem', position: 2, name: 'Docs', item: abs('docs/') },
            ...(isDocsHome ? [] : [{ '@type': 'ListItem', position: 3, name: title, item: pageUrl }]),
          ],
        },
      ],
    };
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
{isNotFound && <meta name="robots" content="noindex" />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
