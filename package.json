    "@angular/router": "~21.2.4",
    "@aws-sdk/client-cognito-identity-provider": "^3.1008.0",
    "@aws-sdk/client-dynamodb": "^3.1008.0",
    "@aws-sdk/client-sns": "^3.1008.0",
    "@aws-sdk/lib-dynamodb": "^3.1008.0",
    "@aws-sdk/util-dynamodb": "^3.996.2",
    "rxjs": "~7.8.0",
    "zone.js": "~0.16.1"
  }
}
