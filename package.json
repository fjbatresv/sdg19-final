{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/patch-angular-build.js",
    "docs:sync-openapi": "node tools/docs/sync-openapi.js",
    "docs:coverage": "node tools/doc-coverage/doc-coverage.js",
    "docs:check": "node tools/docs/sync-openapi.js && nx run docs:check",
    "docs:dev": "node tools/docs/sync-openapi.js && npx astro dev --root docs-site",
    "docs:build": "node tools/docs/sync-openapi.js && npx astro build --root docs-site",
    "docs:preview": "npx astro preview --root docs-site",
    "test:ci": "npx nx run-many -t test --configuration=ci --projects=backend,web,infra",
    "ci:verify": "NX_CLOUD=false NX_DAEMON=false NX_ISOLATE_PLUGINS=false npx nx run-many -t lint test build && NX_CLOUD=false NX_DAEMON=false NX_ISOLATE_PLUGINS=false npm run docs:check && AWS_ACCOUNT_ID=$AWS_ACCOUNT_ID npx cdk synth -c rootDomainName=$ROOT_DOMAIN -c hostedZoneId=$HOSTED_ZONE_ID -c apiDomainName=$API_DOMAIN -c webDomainName=$WEB_DOMAIN -c sesFromAddress=$SES_FROM_ADDRESS -c sesMailFromDomain=$SES_MAIL_FROM_DOMAIN -c enableLambdaVpc=$ENABLE_LAMBDA_VPC"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.2.2",
    "@angular-devkit/core": "~21.2.2",
    "@angular-devkit/schematics": "~21.2.2",
    "@angular/build": "~21.2.2",
    "@angular/cli": "~21.2.2",
    "@angular/compiler-cli": "~21.2.4",
    "@angular/language-service": "~21.2.4",
    "@compodoc/compodoc": "^1.1.32",
    "@astrojs/starlight": "^0.37.1",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "^22.6.3",
    "@nx/esbuild": "22.5.4",
    "@nx/eslint": "22.5.4",
    "@nx/eslint-plugin": "22.5.4",
    "@nx/js": "22.5.4",
    "@nx/node": "^22.5.4",
    "@nx/web": "22.5.4",
    "@schematics/angular": "~21.2.2",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.8",
    "@swc/helpers": "~0.5.18",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "25.0.3",
    "@typescript-eslint/utils": "^8.52.0",
    "astro": "^5.1.0",
    "angular-eslint": "^21.0.1",
    "aws-cdk": "^2.1100.2",
    "aws-cdk-lib": "^2.233.0",
    "constructs": "^10.4.4",
    "esbuild": "^0.27.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "unist-util-visit": "^5.0.0",
    "jsdom": "^27.1.0",
    "nx": "22.5.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.7.4",
    "ts-morph": "^27.0.0",
    "tslib": "^2.3.0",
    "typedoc": "^0.28.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.52.0",
    "@vitest/coverage-v8": "^4.0.8",
    "vitest": "^4.0.8",
    "zod": "^3.25.76"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "packages/*"
  ],
  "overrides": {
    "devalue": "5.6.4",
    "h3": "1.15.5",
    "immutable": "5.1.5",
    "lodash": "4.17.23",
    "qs": "6.14.2",
    "rollup": "4.59.0",
