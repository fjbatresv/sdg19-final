{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "docs:sync-openapi": "node tools/docs/sync-openapi.js",
    "docs:coverage": "node tools/doc-coverage/doc-coverage.js",
    "docs:check": "node tools/docs/sync-openapi.js && nx run docs:check",
    "docs:dev": "node tools/docs/sync-openapi.js && npx astro dev --root docs-site",
    "docs:build": "node tools/docs/sync-openapi.js && npx astro build --root docs-site",
    "docs:preview": "npx astro preview --root docs-site",
    "test:ci": "npx nx run-many -t test --configuration=ci --projects=backend,web,infra",
    "ci:verify": "NX_CLOUD=false NX_DAEMON=false NX_ISOLATE_PLUGINS=false npx nx run-many -t lint test build && NX_CLOUD=false NX_DAEMON=false NX_ISOLATE_PLUGINS=false npm run docs:check && AWS_ACCOUNT_ID=$AWS_ACCOUNT_ID npx cdk synth -c rootDomainName=$ROOT_DOMAIN -c hostedZoneId=$HOSTED_ZONE_ID -c apiDomainName=$API_DOMAIN -c webDomainName=$WEB_DOMAIN -c sesFromAddress=$SES_FROM_ADDRESS -c sesMailFromDomain=$SES_MAIL_FROM_DOMAIN -c enableLambdaVpc=$ENABLE_LAMBDA_VPC"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/starlight": "^0.43.1",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "24.0.6",
    "@nx/esbuild": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/node": "24.0.6",
    "@nx/web": "24.0.6",
    "@schematics/angular": "~22.2.0",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.22",
    "@swc/helpers": "~0.5.24",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@typescript-eslint/utils": "8.73.0",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "22.8.0",
    "astro": "^7.4.13",
    "aws-cdk": "^2.1148.1",
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "nx": "24.0.6",
    "prettier": "^3.10.1",
    "ts-morph": "^28.0.0",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "unist-util-visit": "^5.2.0",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "packages/*"
  ],
  "overrides": {
    "minimatch": "^11.0.9",
    "glob": "^14.0.6",
    "typedoc": {
      "minimatch": "10.2.6"
    }
  },
  "dependencies": {
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1172.0",
    "@aws-sdk/client-dynamodb": "^3.1172.0",
    "@aws-sdk/client-sns": "^3.1172.0",
    "@aws-sdk/lib-dynamodb": "^3.1172.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "rxjs": "~7.8.2",
    "zone.js": "0.16.3"
  }
}
